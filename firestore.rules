rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }

    match /sales/{saleId} {
      allow read: if true;
      allow write: if true;
    }

    match /movements/{movementId} {
      allow read: if true;
      allow write: if true;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
